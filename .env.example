# Copy to .env.local. Never commit real values.
# Creators uses the existing Almost Heard Supabase project. It does not use a
# separate database. Use that project's URL, publishable key, and service-role key.
# .env.local is gitignored.

# Required for sign-in and the private dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only. Required for encrypted storage, verified media, and operator
# membership changes. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server only. 32-byte key, base64. Encrypts creator R2 credentials at rest.
# Required before a creator can save a storage connection.
CREATORS_CREDENTIAL_MASTER_KEY=your-32-byte-base64-key
CREATORS_CREDENTIAL_KEY_VERSION=1

# Leave empty. The value 1 enables the test-only publication control.
# Do not set this in a shared or production environment.
CREATORS_ALLOW_PUBLICATION=

# Optional. The current server does not read this variable. Mutation checks
# trust the request host. Reserved for extra allowed origins, comma-separated.
# Example: https://creators.almostheard.ca
CREATORS_ALLOWED_ORIGINS=

# Optional and tests only. Must name the disposable database creators_migration_review.
# Never point this at the shared Almost Heard database. When unset, tests use
# an in-process PostgreSQL instance.
CREATORS_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/creators_migration_review
