# Copy to .env.local. Never commit real values.
# Dashboard and catalogue metadata use the publishable key with the signed-in user.
# The service-role key stays on the server and is required only for storage secrets,
# verified media finalization, and operator membership changes.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key, base64. Encrypts creator R2 credentials at rest. Server only.
CREATORS_CREDENTIAL_MASTER_KEY=
CREATORS_CREDENTIAL_KEY_VERSION=1

# Must stay unset in any shared or production environment.
# Setting this to 1 enables the test-only publication control.
CREATORS_ALLOW_PUBLICATION=

# Comma-separated extra origins allowed to call mutation routes.
# The request host is always allowed. Example: https://creators.almostheard.ca
CREATORS_ALLOWED_ORIGINS=
